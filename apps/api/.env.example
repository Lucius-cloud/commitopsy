# Copy this file to apps/api/.env and replace the webhook secret.
# Local development database from docker-compose.yml only.
DATABASE_URL=postgres://commitopsy_dev:commitopsy_dev_local_only@127.0.0.1:5433/commitopsy_dev
PORT=4000
NODE_ENV=development
# Generate a random value with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

HEALTH_CHECK_POLL_INTERVAL_MS=5000
HEALTH_CHECK_MAX_CONCURRENT_CHECKS=5
HEALTH_CHECK_BATCH_LIMIT=100
